diff --git a/internal/engine/whatsmeow/outbound_stream_test.go b/internal/engine/whatsmeow/outbound_stream_test.go
new file mode 100644
index 0000000..208ebe0
--- /dev/null
+++ b/internal/engine/whatsmeow/outbound_stream_test.go
@@ -0,0 +1,94 @@
+package whatsmeow
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	wm "go.mau.fi/whatsmeow"
+	waTypes "go.mau.fi/whatsmeow/types"
+
+	"github.com/fazer-ai/whatsapp-connector/internal/protocol"
+)
+
+func onWhatsAppAsGiven(_ context.Context, _ *wm.Client, phones []string) ([]waTypes.IsOnWhatsAppResponse, error) {
+	return []waTypes.IsOnWhatsAppResponse{{Query: phones[0], IsIn: true,
+		JID: waTypes.NewJID("77070000000", waTypes.DefaultUserServer)}}, nil
+}
+
+// A call placed with a media stream: the stream is dialled while the callee is rung and
+// told it is an outbound call to that number, hears `answered` only when the callee picks
+// up, and the voice is wired to it; call.answered carries no SDP, there being no browser.
+func TestACallPlacedWithAStreamIsCarriedByTheStream(t *testing.T) {
+	t.Parallel()
+	server := newMediaServer(t, nil)
+	session := newCallSession(t)
+	session.onWhatsApp = onWhatsAppAsGiven
+	call := &fakeCall{id: "CALLOUT1"}
+	session.dialCall = func(context.Context, string) (bridgedCall, error) { return call, nil }
+
+	result, err := session.Execute(t.Context(), &protocol.Command{
+		ID: "c1", Type: protocol.CommandCallStart, IdempotencyKey: "k1",
+		Payload: json.RawMessage(`{"to":{"kind":"phone","id":"77070000000"},"stream":{"url":"` + server.url + `"}}`),
+	})
+	if err != nil {
+		t.Fatalf("call.start with a stream: %v", err)
+	}
+	if got := decode(t, result)["call_id"]; got != "CALLOUT1" {
+		t.Fatalf("call_id is %v", got)
+	}
+	start := server.next(t)
+	if start["event"] != "start" || start["direction"] != "outbound" || start["peer"] != "77070000000" ||
+		start["call_id"] != "CALLOUT1" {
+		t.Fatalf("the stream was told %v", start)
+	}
+	if _, _, _, wired := call.counts(); wired {
+		t.Fatal("the voice was wired while the callee was still being rung")
+	}
+
+	call.peerAccepts()
+	if frame := server.next(t); frame["event"] != "answered" {
+		t.Fatalf("after the callee picked up the stream heard %v, want answered", frame)
+	}
+	answered := published(t, session, protocol.EventCallAnswered, "event_call_answered")
+	if answered["call_id"] != "CALLOUT1" || answered["sdp"] != "" {
+		t.Fatalf("call.answered is %v, want the call with an empty sdp", answered)
+	}
+	if _, _, _, wired := call.counts(); !wired {
+		t.Fatal("the voice was not wired to the stream")
+	}
+}
+
+// A stream the connector cannot reach hangs the placed call up and fails the command.
+func TestACallPlacedWithAnUnreachableStreamIsHungUp(t *testing.T) {
+	t.Parallel()
+	session := newCallSession(t)
+	session.onWhatsApp = onWhatsAppAsGiven
+	call := &fakeCall{id: "CALLOUT2"}
+	session.dialCall = func(context.Context, string) (bridgedCall, error) { return call, nil }
+
+	_, err := session.Execute(t.Context(), &protocol.Command{
+		ID: "c2", Type: protocol.CommandCallStart, IdempotencyKey: "k2",
+		Payload: json.RawMessage(`{"to":{"kind":"phone","id":"77070000000"},"stream":{"url":"ws://127.0.0.1:1/none"}}`),
+	})
+	if err == nil {
+		t.Fatal("a call.start whose stream cannot be reached succeeded")
+	}
+	waitFor(t, func() bool { _, _, hungUp, _ := call.counts(); return hungUp == 1 }, "the placed call was not hung up")
+}
+
+// Neither an offer nor a stream, or both, is not a call.start.
+func TestACallStartCarriesAnOfferOrAStream(t *testing.T) {
+	t.Parallel()
+	session := newCallSession(t)
+	for _, payload := range []string{
+		`{"to":{"kind":"phone","id":"77070000000"}}`,
+		`{"to":{"kind":"phone","id":"77070000000"},"stream":{"url":""}}`,
+		`{"to":{"kind":"phone","id":"77070000000"},"sdp":"v=0","stream":{"url":"ws://x"}}`,
+	} {
+		_, err := session.Execute(t.Context(), &protocol.Command{
+			ID: "c3", Type: protocol.CommandCallStart, IdempotencyKey: "k3", Payload: json.RawMessage(payload),
+		})
+		assertCode(t, err, protocol.ErrorInvalidPayload)
+	}
+}
