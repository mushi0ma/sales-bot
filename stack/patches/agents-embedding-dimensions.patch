@@ -17,6 +17,11 @@ import { clipText } from "@/lib/text";
 // endpoint can answer with any model at all, at the network boundary too (`assertWidth`).
 export const EMBEDDING_DIM = 1536;
 
+// Ask the endpoint for EMBEDDING_DIM-wide vectors (`dimensions` in the OpenAI request). Off by default:
