+// (nemotron-embed 2048/4096, gemini-embedding 3072), which would otherwise fail `assertWidth`.
+export const SEND_DIMENSIONS = process.env.EMBEDDING_SEND_DIMENSIONS === "true";
+
 export interface EmbeddingConfig {
   model: string;
   apiKey: string;
