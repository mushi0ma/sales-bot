@@ -0,0 +1,6 @@
+# salesbot: group messages of an API inbox (stack/tg-userbot), see Api::V1::Accounts::Inboxes::GroupMessagesController.
+# A route of its own here rather than a line in config/routes.rb, which the other salesbot patches also touch.
+Rails.application.routes.prepend do
+  post '/api/v1/accounts/:account_id/inboxes/:inbox_id/group_messages',
+       to: 'api/v1/accounts/inboxes/group_messages#create', defaults: { format: 'json' }
+end
