+  # A 1:1 voice call handed to the voice agent's media stream (WHATSAPP_VOICE_AGENT_URL). The connector dials
+  # the URL and answers on WhatsApp once it is open.
+  def accept_call_with_stream(call_id, url)
+    backend.accept_call(model::Commands::CallAccept.new(call_id: call_id, sdp: nil, stream: { 'url' => url }))
+  end
+
   private
 
+  # The connector carries the voice of a call only for a session that asked for it on connect, and every
+  # connect states the whole request: so it is asked here, on both connects, whenever a voice agent is set.
+  def voice_agent_calls
+    ENV['WHATSAPP_VOICE_AGENT_URL'].present? ? { 'answer' => true } : nil
+  end
+
   def capability?(capability)
     channel.session_capabilities.include?(capability)
   end
