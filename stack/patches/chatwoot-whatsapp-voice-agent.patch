diff --git a/app/services/whatsapp/session/inbound/handlers/call_offer.rb b/app/services/whatsapp/session/inbound/handlers/call_offer.rb
index 96443e0..eaadfc2 100644
--- a/app/services/whatsapp/session/inbound/handlers/call_offer.rb
+++ b/app/services/whatsapp/session/inbound/handlers/call_offer.rb
@@ -11,11 +11,26 @@ class Whatsapp::Session::Inbound::Handlers::CallOffer < Whatsapp::Session::Inbou
     return :ignored unless capability?(:calls)
     return :ignored if payload.from.blank?
 
-    inbound::Locks.with_chat_lock(inbox, payload.from.source_id) { write_the_line }
+    result = inbound::Locks.with_chat_lock(inbox, payload.from.source_id) { write_the_line }
+    hand_to_voice_agent if result == :handled
+    result
   end
 
   private
 
+  # WHATSAPP_VOICE_AGENT_URL set: the voice agent takes every 1:1 voice call instead of the operator's phone.
+  # Outside the chat lock: the connector waits up to 5 s for the agent's socket. A failure leaves the call
+  # ringing, which is what happens without an agent.
+  def hand_to_voice_agent
+    url = ENV.fetch('WHATSAPP_VOICE_AGENT_URL', '')
+    return if url.blank? || payload.video || payload.call_id.blank? || payload.from.group?
+
+    channel.provider_service.accept_call_with_stream(payload.call_id, url)
+    Rails.logger.info("[whatsapp] call #{payload.call_id} handed to the voice agent")
+  rescue StandardError => e
+    Rails.logger.warn("[whatsapp] call #{payload.call_id} not handed to the voice agent: #{e.class}: #{e.message}")
+  end
+
   # Prefixed, and not the raw call id: this shares a column with WhatsApp's message ids,
   # and the prefix is what keeps a call from ever being the target of an edit, a revoke
   # or a reaction that names the same string.
